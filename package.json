{
  "name": "@estmcmxci/mm-plugin-ensv2",
  "version": "0.8.0",
  "description": "ENSv2 for the MetaMask Agent Wallet CLI (mm): fail-closed, generation-aware detection across two pinned Sepolia deployments, resolution, agent identity, primary names, and durable provisioning jobs",
  "author": "estmcmxci 𝔪✶ (https://estmcmxci.co)",
  "license": "MIT",
  "homepage": "https://github.com/estmcmxci/mm-plugin-ensv2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estmcmxci/mm-plugin-ensv2.git"
  },
  "bugs": {
    "url": "https://github.com/estmcmxci/mm-plugin-ensv2/issues"
  },
  "keywords": [
    "oclif-plugin",
    "mm-plugin",
    "metamask",
    "agent-wallet",
    "ens",
    "ensv2",
    "erc-8004",
    "agent-identity",
    "ensip-25",
    "ensip-26",
    "sepolia"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "oclif.manifest.json",
    "schemas/PROVENANCE.md",
    "schemas/common-primitives.schema.json",
    "schemas/deployment-manifest.schema.json",
    "schemas/errors.schema.json",
    "schemas/provisioning-intent.schema.json",
    "schemas/provisioning-job.schema.json",
    "schemas/step-receipt.schema.json",
    "schemas/verification-result.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && oclif manifest",
    "prepack": "tsc -p tsconfig.json && oclif manifest",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "ensv2": {
        "description": "ENSv2 names and agent identity (Sepolia)"
      },
      "ensv2:resolver": {
        "description": "Inspect, predict, and deploy this wallet's ENSv2 resolver"
      },
      "ensv2:agent": {
        "description": "ERC-8004 agent identity bound to an ENSv2 name (via Adapter8004)"
      },
      "ensv2:records": {
        "description": "The name's records: addr, profile, ENSIP-25/26 agent records"
      },
      "ensv2:primary": {
        "description": "This wallet's primary name (reverse resolution): read it, set it"
      },
      "ensv2:jobs": {
        "description": "Durable provisioning jobs: list, inspect, resume (never repeats a paid step)"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^6.2.0",
    "capabilities": [],
    "commands": [
      {
        "id": "ensv2:status",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "network"
        ],
        "targetChains": [
          11155111
        ]
      },
      {
        "id": "ensv2:resolve",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "network"
        ],
        "targetChains": [
